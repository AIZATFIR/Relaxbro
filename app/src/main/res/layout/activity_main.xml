<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A67C52"
    tools:context=".MainActivity">

    <!-- Universal Wood Background -->
    <ImageView
        android:id="@+id/bgUniversal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_32_01_am__1_" />

    <!-- Title Banner Header -->
    <ImageView
        android:id="@+id/imgTitleHeader"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Title Banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_50_09_am" />

    <TextView
        android:id="@+id/tvBerandaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/hachi_maru_pop"
        android:maxLines="2"
        android:text="@string/main_greeting"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgTitleHeader" />

    <!-- Item 1: Pop It Toy -->
    <ImageView
        android:id="@+id/btnPopIt"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:contentDescription="Pop It Toy"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toStartOf="@id/beruang"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBerandaTitle"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_42_43_am" />

    <!-- Item 2: Piano Bear -->
    <ImageView
        android:id="@+id/beruang"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:clickable="true"
        android:contentDescription="Piano Bear"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@+id/btnPopIt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnPopIt"
        app:layout_constraintTop_toTopOf="@+id/btnPopIt"
        app:srcCompat="@drawable/real_bgt" />

    <!-- Tombol Play Piano -->
    <Button
        android:id="@+id/btnPlayPiano"
        android:layout_width="140dp"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#5D3A1A"
        android:text="PLAY PIANO"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="21dp"
        app:layout_constraintEnd_toEndOf="@id/beruang"
        app:layout_constraintStart_toStartOf="@id/beruang"
        app:layout_constraintTop_toBottomOf="@+id/beruang" />

    <!-- Section Kustomisasi Tema & Input Nama -->
    <LinearLayout
        android:id="@+id/panelCustomization"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="#60000000"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Baris Input Nama + Tombol Submit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background"
                android:fontFamily="@font/hachi_maru_pop"
                android:hint="Masukkan Username..."
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="#333333"
                android:textColorHint="#888888"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button5"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#5D3A1A"
                android:text="Submit"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Baris Tombol Pilih Warna Tema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#964B00"
                android:padding="0dp"
                android:text="Coklat Classic"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:backgroundTint="#9CAF88"
                android:padding="0dp"
                android:text="Hijau Sage"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/button4"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#191970"
                android:padding="0dp"
                android:text="Biru Tenang"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
