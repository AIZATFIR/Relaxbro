<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A67C52"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvBerandaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Pilih Fidget Toy"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Item 1: Pop It Toy -->
    <ImageView
        android:id="@+id/btnPopIt"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:contentDescription="Pop It Toy"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toStartOf="@id/btnFidget2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBerandaTitle"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_32_01_am__1_" />

    <!-- Item 2: Fidget Toy 2 -->
    <ImageView
        android:id="@+id/btnFidget2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:clickable="true"
        android:contentDescription="Fidget 2"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="@id/btnPopIt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnPopIt"
        app:layout_constraintTop_toTopOf="@id/btnPopIt"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_42_43_am" />

    <!-- Item 3: Fidget Toy 3 -->
    <ImageView
        android:id="@+id/btnFidget3"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:contentDescription="Fidget 3"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPopIt"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_50_09_am" />

</androidx.constraintlayout.widget.ConstraintLayout>
