<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/name_input_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgbgbg"
    tools:context=".NameInputActivity">

    <!-- Universal Wood Background -->
    <ImageView
        android:id="@+id/bgUniversal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_32_01_am__1_" />

    <!-- Title Banner Header -->
    <ImageView
        android:id="@+id/imgTitleHeader"
        android:layout_width="260dp"
        android:layout_height="90dp"
        android:layout_marginTop="48dp"
        android:contentDescription="Title Banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chatgpt_image_sep_23__2026__09_50_09_am" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/hachi_maru_pop"
        android:text="Selamat Datang!"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgTitleHeader" />

    <!-- Submit Button at Bottom -->
    <Button
        android:id="@+id/btnMulai"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginBottom="36dp"
        android:backgroundTint="#5D3A1A"
        android:text="Mulai"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Name EditText above Submit Button -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background"
        android:fontFamily="@font/hachi_maru_pop"
        android:hint="Masukkan Nama..."
        android:inputType="textPersonName"
        android:maxLength="20"
        android:paddingHorizontal="16dp"
        android:textColor="#333333"
        android:textColorHint="#888888"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btnMulai"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
